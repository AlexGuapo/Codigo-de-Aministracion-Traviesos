# Copiar a .env y llenar. El .env nunca se sube al repositorio.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 1 en el servidor: HTTPS, cookies seguras y DEBUG apagado
SARRCA_PRODUCCION=0
# Proxies delante de la web (Caddy = 1); en desarrollo, 0
SARRCA_PROXIES_CONFIABLES=0
SARRCA_NIVEL_LOG=INFO

# Base de datos (PostgreSQL en Docker). Estos valores son para correr pytest y manage.py
# desde tu máquina; dentro de Docker, docker-compose.yml usa el host "db" y el puerto 5432.
# Si el 5432 de tu máquina está ocupado, usa otro (por ejemplo, 55432).
SARRCA_DB_NOMBRE=sarrca
SARRCA_DB_USUARIO=sarrca
SARRCA_DB_CONTRASENA=
SARRCA_DB_HOST=127.0.0.1
SARRCA_DB_PUERTO=5432

# Clave para cifrar la MAC y el token de los sensores (Fernet). Se genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SARRCA_CLAVE_SECRETOS=
